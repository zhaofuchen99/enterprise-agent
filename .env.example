# 复制为 .env 后按需修改：make bootstrap
# 密钥只从环境变量加载，**任何情况下不得提交 .env 或写入 Compose 明文**。

# ---------------------------------------------------------------- 应用
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
TASK_TIMEOUT_SECONDS=600
CHAT_MESSAGE_MAX_LENGTH=4000
# 并发与限流配额（详细设计 19.3）；Phase 1.5 起计数改由 Redis 承载以跨实例一致
MAX_RUNNING_TASKS_PER_USER=3
RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_STATUS_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_HOUR=10

# ------------------------------------------------- 模型（TBC-04 未决，待选型）
MODEL_PROVIDER=openai-compatible
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=120

EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

RERANKER_MODEL=
RERANKER_ENABLED=false

# ---------------------------------------------------------------- 数据库
DATABASE_URL_AGENT=mysql+asyncmy://agent:agent_pw@127.0.0.1:3308/agent
DATABASE_URL_BUSINESS_RO=mysql+asyncmy://readonly:readonly_pw@127.0.0.1:3307/business
# 业务库的**写**连接，仅供 `make seed` 建表灌数使用。
# 应用运行时不读这个变量（API/Worker 走上面的 RO），
# 因此即使留着它，"写操作必须被数据库拒绝" 这条约束依然由数据库保证。
DATABASE_URL_BUSINESS_RW=mysql+asyncmy://root:root_pw@127.0.0.1:3307/business
DB_POOL_SIZE=10

# ---------------------------------------------------------------- Redis
# 宿主端口 6381：6379 被本机原生 redis 占用（见 docker-compose.dev.yml 注释）
REDIS_URL=redis://127.0.0.1:6381/0
REDIS_MAX_CONNECTIONS=50
# 嵌套段用双下划线（详细设计 19.5 的 redis 段）。
# 段名是 REDIS_TUNING__ 而不是 REDIS__：本文件已有扁平的 REDIS_URL，
# 若再有一个嵌套的 REDIS__URL，写错的那个会被静默忽略，排查成本很高。
REDIS_TUNING__STREAM_MAXLEN=10000
REDIS_TUNING__STREAM_TTL_SECONDS=3600
REDIS_TUNING__LOCK_TTL_SECONDS=30
REDIS_TUNING__CACHE_TTL_SECONDS=3600
# Redis 不可用时本地限流的收紧系数（0.5 等价于按 2 个实例均分），只允许收紧
REDIS_TUNING__RATE_LIMIT_DEGRADED_FACTOR=0.5
# 熔断冷却：失败后这段时间内直接走降级，不再每个请求都等一次命令超时
REDIS_TUNING__RATE_LIMIT_BREAKER_SECONDS=5.0
# 单次 Redis 命令超时，限流与健康检查必须快速失败
REDIS_TUNING__OPERATION_TIMEOUT_SECONDS=1.0

# ------------------------------------------------------------ Worker 与队列
WORKER__CONCURRENCY=4
WORKER__HEARTBEAT_INTERVAL_SECONDS=10
# 必须 >= 心跳周期的 2 倍（要容忍漏掉一拍），否则启动即报错
WORKER__HEARTBEAT_TTL_SECONDS=30
# QUEUED 超过这么久仍未进队列即重投；最多重投 2 次，超过置 FAILED
WORKER__QUEUE_RECONCILE_SECONDS=30
WORKER__MAX_REQUEUE_ATTEMPTS=2
WORKER__ORPHAN_SCAN_INTERVAL_SECONDS=30
# 收到停机信号后等多久再中断在跑任务，超过则由孤儿回收接手
WORKER__SHUTDOWN_GRACE_SECONDS=10

# ---------------------------------------------------------------- 向量库
MILVUS_URI=http://127.0.0.1:19530
RAG_SCORE_THRESHOLD=0.35
RAG_TOP_K=20
RAG_RERANK_TOP_N=8
RAG_USER_DICT=configs/rag_user_dict.txt
RAG_STOPWORDS=configs/rag_stopwords.txt

# ---------------------------------------------------------------- 存储
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-knowledge

# ---------------------------------------------------------------- 认证
JWT_SECRET=change-me-to-a-random-32-bytes-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------------------------------------------------------------- 可观测
# 进程角色（api / worker）由入口模块决定，**不是环境变量**：
# make run 同时起两个进程、共用这一份 .env，用环境变量区分必然失效。
OTEL_ENABLED=false
OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SAMPLE_RATE=1.0
SENTRY_DSN=

# ---------------------------------------------------------------- 外部搜索
SEARCH_ENABLED=false
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---------------------------------------------------------------- 循环预算
# 四类预算相互独立不可借用；修改后必须重跑循环类评测集
LOOP__MAX_TOTAL_STEPS=24
LOOP__MAX_EXPANSIONS=2
LOOP__MAX_STEPS_PER_EXPANSION=6
LOOP__MAX_DRILLDOWN_DEPTH=3
LOOP__MIN_STEP_SECONDS=1.0
LOOP__DUPLICATE_SIMILARITY_THRESHOLD=0.92
LOOP__MAX_SQL_REPAIRS=2
LOOP__MAX_REPLANS=1
LOOP__MAX_REVIEWER_EVIDENCE=1
